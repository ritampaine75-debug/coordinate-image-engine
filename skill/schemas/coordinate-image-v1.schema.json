{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coordinate-image-engine.invalid/schemas/coordinate-image-v1.schema.json",
  "title": "Coordinate Image v1 document",
  "description": "Strict schema for deterministic, local, browser-rendered vector drawing instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "canvas",
    "elements"
  ],
  "properties": {
    "protocol": {
      "const": "coordinate-image-v1"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "gradients": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "minProperties": 0,
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/gradient"
      }
    },
    "elements": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/element"
      },
      "maxItems": 1000
    }
  },
  "$defs": {
    "coordinate": {
      "type": "number",
      "minimum": -100000,
      "maximum": 100000,
      "description": "Finite canvas-space number. Values outside the canvas are allowed but clipped."
    },
    "positiveLength": {
      "type": "number",
      "maximum": 100000,
      "exclusiveMinimum": 0
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "color": {
      "type": "string",
      "minLength": 3,
      "maxLength": 9,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "paint": {
      "oneOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "$ref": "#/$defs/gradientReference"
        }
      ],
      "description": "Colors use #RGB, #RRGGBB, or #RRGGBBAA. Gradient references must name a top-level gradient."
    },
    "gradientReference": {
      "type": "object",
      "properties": {
        "gradient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "gradient"
      ],
      "additionalProperties": false
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strokeWidth": {
      "type": "number",
      "maximum": 128,
      "exclusiveMinimum": 0
    },
    "shadow": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "minLength": 3,
          "maxLength": 9,
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        },
        "offsetX": {
          "type": "number",
          "minimum": -256,
          "maximum": 256
        },
        "offsetY": {
          "type": "number",
          "minimum": -256,
          "maximum": 256
        }
      },
      "required": [
        "color",
        "blur"
      ],
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "translate": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "maxItems": 2
        },
        "origin": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          },
          "maxItems": 2
        },
        "rotate": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "scale": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "maximum": 100,
            "exclusiveMinimum": 0
          },
          "maxItems": 2
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Coordinates are scaled about origin, rotated clockwise, moved back, then translated."
    },
    "gradientStop": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "type": "string",
          "minLength": 3,
          "maxLength": 9,
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      },
      "required": [
        "offset",
        "color"
      ],
      "additionalProperties": false
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/gradientStop"
      },
      "maxItems": 16
    },
    "linearGradient": {
      "type": "object",
      "properties": {
        "type": {
          "const": "linear"
        },
        "x1": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y1": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "x2": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y2": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "stops": {
          "$ref": "#/$defs/stops"
        }
      },
      "required": [
        "type",
        "x1",
        "y1",
        "x2",
        "y2",
        "stops"
      ],
      "additionalProperties": false
    },
    "radialGradient": {
      "type": "object",
      "properties": {
        "type": {
          "const": "radial"
        },
        "cx": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "cy": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "r": {
          "type": "number",
          "maximum": 100000,
          "exclusiveMinimum": 0
        },
        "stops": {
          "$ref": "#/$defs/stops"
        }
      },
      "required": [
        "type",
        "cx",
        "cy",
        "r",
        "stops"
      ],
      "additionalProperties": false
    },
    "gradient": {
      "oneOf": [
        {
          "$ref": "#/$defs/linearGradient"
        },
        {
          "$ref": "#/$defs/radialGradient"
        }
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "$ref": "#/$defs/gradientReference"
            }
          ],
          "description": "A hex color or a reference to a named gradient."
        }
      },
      "required": [
        "width",
        "height",
        "background"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tags": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "maxItems": 16
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "element": {
      "oneOf": [
