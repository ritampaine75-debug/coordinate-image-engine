            "round",
            "square"
          ]
        },
        "lineJoin": {
          "enum": [
            "miter",
            "round",
            "bevel"
          ]
        },
        "dash": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "maximum": 1024,
            "exclusiveMinimum": 0
